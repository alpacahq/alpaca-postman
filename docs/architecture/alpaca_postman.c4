    include alpaca_postman, ext_broker_api, ext_trader_api, ext_market_data_api, ext_postman_workspace, ext_developer_docs, ext_github_issues, ext_alpaca_signup, developer_user
    autoLayout TopBottom
  }
  view alpaca_postman_containers of alpaca_postman {
